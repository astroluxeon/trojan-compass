modules = ["nodejs-22"]
run = "npm run build && npm start"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci --include=dev && npm run build"]
run = ["npm", "start"]

[env]
PORT = "3000"
ALLOW_DEMO_DATA = "true"
PUBLIC_APP_URL = "https://trojan-compass--eddiekao01.replit.app"

[[ports]]
localPort = 3000
externalPort = 80
