PORT=4000
HOST=127.0.0.1
# Development uses illustrative records. Production requires a published file dataset.
DATASET_MODE=prototype
# DATASET_ROOT=/absolute/path/to/published/snapshots
# CURSOR_SECRET=use-a-random-secret-of-at-least-32-bytes-shared-across-replicas
AI_PROVIDER=disabled
# Set AI_PROVIDER=openai and configure a model that supports structured outputs.
# OPENAI_API_KEY=
# OPENAI_MODEL=
AI_MAX_CONCURRENCY=8
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Trust only your actual reverse proxy addresses/CIDRs.
# TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128
REQUEST_TIMEOUT_MS=10000
CHAT_TIMEOUT_MS=45000
RATE_LIMIT_PER_MINUTE=240
CHAT_RATE_LIMIT_PER_MINUTE=20
SHUTDOWN_TIMEOUT_MS=10000
EXPOSE_GRAPH=false
# Never put provider credentials or cursor secrets in NEXT_PUBLIC_ variables.
