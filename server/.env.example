PORT=4000
HOST=127.0.0.1
# Absolute public API and viewer origins, used in returned scene/asset links.
PUBLIC_API_BASE_URL=http://127.0.0.1:4000
VIEWER_BASE_URL=http://localhost:3000
# Optional absolute snapshots directory; defaults resolve relative to the server module.
# DATASET_ROOT=C:/path/to/snapshots
# local runs deterministic map commands without an external provider.
# openai enables the server-only structured intent adapter and requires both settings.
AI_MODE=local
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1
# Never put credentials in the frontend or in NEXT_PUBLIC_ variables.
